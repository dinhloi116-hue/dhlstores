{
  "manifest_version": 3,
  "name": "DHL Stock Sync",
  "version": "0.15.0",
  "minimum_chrome_version": "116",
  "description": "Lưu hồ sơ Sapo theo từng nhóm hàng trên máy; chọn hồ sơ, quét đúng tab danh mục đang mở và tạo file nhập tồn kho mà không phải nạp lại Excel mỗi lần.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs", "sidePanel", "scripting"],
  "host_permissions": ["https://si.aobongda.net/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Mở DHL Stock Sync"},
  "side_panel": {"default_path": "popup.html"},
  "content_scripts": [
    {
      "matches": ["https://si.aobongda.net/*"],
      "js": ["safe-category-guard.js", "stock-core.js", "dom-stock-parser.js", "match-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
