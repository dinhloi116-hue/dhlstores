{
  "manifest_version": 3,
  "name": "DHL Stock Sync",
  "version": "0.14.5",
  "minimum_chrome_version": "116",
  "description": "Quét tồn từ danh mục si.aobongda.net; bảo trì nguồn mở popup an toàn và đọc trực tiếp từng dòng size/tồn, không suy đoán tồn 0; hỗ trợ size chữ/size số và tạo file Sapo có link ảnh.",
  "permissions": ["storage", "activeTab", "tabs", "sidePanel", "scripting"],
  "host_permissions": ["https://si.aobongda.net/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Mở DHL Stock Sync"},
  "side_panel": {"default_path": "popup.html"},
  "content_scripts": [
    {
      "matches": ["https://si.aobongda.net/*"],
      "js": ["safe-category-guard.js", "stock-core.js", "dom-stock-parser.js", "match-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
