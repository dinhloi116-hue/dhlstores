{
  "manifest_version": 3,
  "name": "DHL Stock Sync",
  "version": "0.14.0",
  "minimum_chrome_version": "116",
  "description": "Quét tồn từ bất kỳ danh mục đang mở trên si.aobongda.net, hỗ trợ cả size chữ và size số; tạo file nhập tồn kho và file tạo sản phẩm mới Sapo có link ảnh.",
  "permissions": ["storage", "activeTab", "tabs", "sidePanel", "scripting"],
  "host_permissions": ["https://si.aobongda.net/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Mở DHL Stock Sync"},
  "side_panel": {"default_path": "popup.html"},
  "content_scripts": [
    {
      "matches": ["https://si.aobongda.net/*"],
      "js": ["stock-core.js", "dom-stock-parser.js", "match-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
