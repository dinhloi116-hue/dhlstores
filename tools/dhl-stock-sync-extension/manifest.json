{
  "manifest_version": 3,
  "name": "DHL Stock Sync",
  "version": "0.14.6",
  "minimum_chrome_version": "116",
  "description": "Quét tồn đúng trang danh mục đang mở trên si.aobongda.net; không tự chuyển về HD người lớn; bảo trì nguồn đọc popup trực tiếp và không suy đoán tồn 0.",
  "permissions": ["storage", "activeTab", "tabs", "sidePanel", "scripting"],
  "host_permissions": ["https://si.aobongda.net/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Mở DHL Stock Sync"},
  "side_panel": {"default_path": "popup.html"},
  "content_scripts": [
    {
      "matches": ["https://si.aobongda.net/*"],
      "js": ["safe-category-guard.js", "stock-core.js", "dom-stock-parser.js", "match-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
