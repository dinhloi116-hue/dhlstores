{
  "manifest_version": 3,
  "name": "DHL Stock Sync",
  "version": "0.19.0",
  "minimum_chrome_version": "116",
  "description": "Tự quét các hồ sơ đã chọn theo chu kỳ 1/2/3 giờ, lưu cache/lịch sử và có thể tự ghi tồn theo chi nhánh Sapo sau khi xác minh kết nối. Luồng quét tay vẫn được giữ nguyên.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs", "sidePanel", "scripting", "alarms"],
  "host_permissions": ["https://si.aobongda.net/*", "https://*.mysapo.net/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Mở DHL Stock Sync"},
  "side_panel": {"default_path": "popup.html"},
  "content_scripts": [
    {
      "matches": ["https://si.aobongda.net/*"],
      "js": ["safe-category-guard.js", "stock-core.js", "dom-stock-parser.js", "match-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
