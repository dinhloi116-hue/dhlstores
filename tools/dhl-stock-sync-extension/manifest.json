{
  "manifest_version": 3,
  "name": "DHL Stock Sync",
  "version": "0.13.4",
  "minimum_chrome_version": "116",
  "description": "Dùng file Quản lý kho chỉ để đối chiếu; quét tồn nguồn và luôn tạo file mới theo đúng mẫu nhập tồn kho chính thức của Sapo.",
  "permissions": ["storage", "activeTab", "tabs", "sidePanel", "scripting"],
  "host_permissions": ["https://si.aobongda.net/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Mở DHL Stock Sync"},
  "side_panel": {"default_path": "popup.html"},
  "content_scripts": [
    {
      "matches": ["https://si.aobongda.net/*"],
      "js": ["stock-core.js", "dom-stock-parser.js", "match-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
