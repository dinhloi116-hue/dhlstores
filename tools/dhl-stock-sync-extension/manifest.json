{
  "manifest_version": 3,
  "name": "DHL Stock Sync",
  "version": "0.10.0",
  "minimum_chrome_version": "116",
  "description": "Quét đúng S/M/L/XL/XXL theo từng màu trên si.aobongda.net và tạo file nhập Sapo theo từng biến thể, chỉ thay đổi tồn kho.",
  "permissions": ["storage", "activeTab", "tabs", "sidePanel", "scripting"],
  "host_permissions": ["https://si.aobongda.net/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Mở DHL Stock Sync"},
  "side_panel": {"default_path": "popup.html"},
  "content_scripts": [
    {
      "matches": ["https://si.aobongda.net/*"],
      "js": ["stock-core.js", "dom-stock-parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
