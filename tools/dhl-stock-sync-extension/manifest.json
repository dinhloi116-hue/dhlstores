{
  "manifest_version": 3,
  "name": "DHL Stock Sync",
  "version": "0.22.5",
  "minimum_chrome_version": "116",
  "description": "UI nhẹ và rõ hơn: progress quét/đẩy Sapo, feedback nút, reduced-motion, lazy-load tự sắp xếp lại; không thêm polling/animation loop.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "sidePanel",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://si.aobongda.net/*",
    "https://*.mysapo.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mở DHL Stock Sync"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://si.aobongda.net/*"
      ],
      "js": [
        "safe-category-guard.js",
        "stock-core.js",
        "dom-stock-parser.js",
        "match-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
