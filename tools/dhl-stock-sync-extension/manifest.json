{
  "manifest_version": 3,
  "name": "DHL Stock Sync",
  "version": "0.16.2",
  "minimum_chrome_version": "116",
  "description": "UI v3: giao diện gọn hơn, hiển thị sức khỏe hồ sơ và lịch sử đồng bộ; tự nhận đúng HD/Trẻ em/Wika/Strivend; core ghép SKU/tồn kho giữ nguyên bản ổn.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs", "sidePanel", "scripting"],
  "host_permissions": ["https://si.aobongda.net/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Mở DHL Stock Sync"},
  "side_panel": {"default_path": "popup.html"},
  "content_scripts": [
    {
      "matches": ["https://si.aobongda.net/*"],
      "js": ["safe-category-guard.js", "stock-core.js", "dom-stock-parser.js", "match-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
