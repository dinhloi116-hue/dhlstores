@echo off
setlocal EnableExtensions
chcp 65001 >nul
title Cai tool Tach Nameset A3 cho CorelDRAW
set "DHL_SELF=%~f0"

fltmc >nul 2>&1
if not "%errorlevel%"=="0" (
  powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath $env:DHL_SELF -Verb RunAs"
  exit /b
)

powershell -NoProfile -ExecutionPolicy Bypass -Command "$p=$env:DHL_SELF; $lines=[IO.File]::ReadAllLines($p); $mark=[Array]::IndexOf($lines,'#==POWERSHELL=='); if($mark -lt 0){throw 'Khong tim thay du lieu cai dat'}; $code=($lines[($mark+1)..($lines.Length-1)] -join [Environment]::NewLine); Invoke-Expression $code"
set "DHL_EXIT=%errorlevel%"
echo.
pause
exit /b %DHL_EXIT%

#==POWERSHELL==
$ErrorActionPreference = 'Stop'

if (Get-Process -Name CorelDRW -ErrorAction SilentlyContinue) {
    Write-Host ''
    Write-Host 'HAY TAT COREL DRAW ROI CHAY LAI FILE CAI NAY.' -ForegroundColor Yellow
    Write-Host 'Tool khong tu dong dong file dang lam cua ban.'
    exit 2
}

$programFiles = [Environment]::GetFolderPath('ProgramFiles')
$preferred = @('2024','2025','2026','2023','2022') | ForEach-Object {
    Join-Path $programFiles "Corel\CorelDRAW Graphics Suite $_\Programs64\CorelDRW.exe"
}
$corelExe = $preferred | Where-Object { Test-Path -LiteralPath $_ } | Select-Object -First 1
if (-not $corelExe) {
    $corelExe = Get-ChildItem -LiteralPath (Join-Path $programFiles 'Corel') -Filter CorelDRW.exe -File -Recurse -ErrorAction SilentlyContinue | Select-Object -ExpandProperty FullName -First 1
}
if (-not $corelExe) {
    Write-Host ''
    Write-Host 'Khong tim thay CorelDRAW 64-bit trong may.' -ForegroundColor Red
    exit 4
}

$programsDir = Split-Path -Parent $corelExe
$target = Join-Path $programsDir 'Addons\DHL_A3_Nameset'
if (Test-Path -LiteralPath $target) { Remove-Item -LiteralPath $target -Recurse -Force }
New-Item -ItemType Directory -Path $target -Force | Out-Null

$files = @{}
$files['CorelDrw.addon'] = @'
Cg==
'@

$files['AppUI.xslt'] = @'

'@

$files['UserUI.xslt'] = @'

'@

$files['DockerUI.html'] = @'

'@

$files['main.js'] = @'

'@

foreach ($name in $files.Keys) {
    $bytes = [Convert]::FromBase64String(($files[$name] -replace '\s',''))
    [IO.File]::WriteAllBytes((Join-Path $target $name), $bytes)
}

$html = Join-Path $target 'DockerUI.html'
$uri = ([Uri]$html).AbsoluteUri
$xslt = Join-Path $target 'AppUI.xslt'
$text = [IO.File]::ReadAllText($xslt).Replace('__DOCKER_URL__', $uri)
[IO.File]::WriteAllText($xslt, $text, (New-Object Text.UTF8Encoding($false)))
Get-ChildItem -LiteralPath $target -File -Recurse | Unblock-File

if (-not (Test-Path -LiteralPath $html)) { throw 'Khong ghi duoc giao dien tool.' }
Write-Host ''
Write-Host 'DA CAI XONG TOOL TACH NAMESET A3 - BAN V5' -ForegroundColor Green
Write-Host 'Mo CorelDRAW > Window > Dockers > Tach Nameset A3.'
Write-Host 'Keo bang tool sat canh phai de ghim, hoac keo ra ngoai de dung dang noi.'
exit 0
