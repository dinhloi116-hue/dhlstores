{
  "manifest_version": 3,
  "name": "DHL AI Video Studio",
  "description": "Phân tích video, chỉnh phân cảnh và lưu dự án lên Google Drive.",
  "version": "0.1.0",
  "permissions": ["storage", "identity", "tabs"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_CHROME_EXTENSION_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.file"]
  },
  "action": { "default_title": "DHL AI Video Studio", "default_popup": "popup.html" }
}