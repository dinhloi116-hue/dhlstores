# Never commit real keys; Free Tier is quota-limited and may use submitted data to improve models.
GEMINI_API_KEY=your_server_side_gemini_api_key_here
PRODUCT_STUDIO_PASSWORD=replace_with_long_random_password
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
HOST=127.0.0.1
PORT=4177
MAX_AI_CALLS_PER_HOUR=20

# Google Drive OAuth — READ ONLY, configure these ONLY on your server.
# Obtain a refresh token with https://www.googleapis.com/auth/drive.readonly.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
# JSON map: use direct 6 shop folder IDs, not the overall Drive root ID.
DRIVE_SHOP_FOLDERS_JSON={"DHL SPORTS":"folder_id_here","DHL STUDIO":"folder_id_here"}
# Exact XLSX IDs from your Drive; DO NOT use native Google Sheets for these IDs.
DRIVE_BIGSELLER_TEMPLATE_ID=your_bigseller_xlsx_id
DRIVE_LAZADA_TEMPLATE_ID=your_lazada_xlsx_id
DRIVE_SHOPEE_PRICE_FILE_ID=your_shopee_reference_xlsx_id
